<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>

    <style>
        body{
            font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin:40px;
        }

        form{
            margin:20px 0;
        }

        input{
            padding:8px;
            width:300px;
        }

        button{
            padding:8px 14px;
            cursor:pointer;
        }

        table{
            border-collapse: collapse;
            margin-top:20px;
            width:100%;
        }

        th,td{
            border:1px solid #ccc;
            padding:10px;
            text-align:left;
        }

        th{
            font-weight:bold;
        }
    </style>
</head>
<body>

    <h1>URL Shortner</h1>

    <% if (locals.id) { %>
        <p>
            URL Generated:
            <a href="/<%= id %>">
                http://localhost:8001/<%= id %>
            </a>
        </p>
    <% } %>

    <div>
        <form method="POST" action="/url">
            <label>Enter your Original URL:</label>
            <input
                type="text"
                name="url"
                placeholder="https://example.com"
                required
            />
            <button type="submit">Generate</button>
        </form>
    </div>


    <% if (locals.urls && urls.length > 0) { %>

    <div>
        <table>
            <thead>
                <tr>
                    <th>S. No</th>
                    <th>ShortId</th>
                    <th>Redirect URL</th>
                    <th>Clicks</th>
                </tr>
            </thead>

            <tbody>
                <% urls.forEach((url,index)=>{ %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><%= url.shortId %></td>
                        <td><%= url.redirectURL %></td>
                        <td><%= url.visitHistory.length %></td>
                    </tr>
                <% }) %>
            </tbody>

        </table>
    </div>

    <% } %>

</body>
</html>